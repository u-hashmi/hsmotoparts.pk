generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  // Bike-model categories (70cc, CG 125, ...) show in "Shop by bike";
  // the rest show as accessory tiles on the home page.
  isBike      Boolean   @default(false)
  imageUrl    String?
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  description    String      @default("")
  // Prices are whole Pakistani rupees.
  price          Int
  compareAtPrice Int?
  stock          Int         @default(0)
  sku            String?
  partType       String?
  images         String[]
  featured       Boolean     @default(false)
  active         Boolean     @default(true)
  categories     Category[]
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

enum PaymentMethod {
  COD
  JAZZCASH
  EASYPAISA
  BANK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  AWAITING_VERIFICATION
  PAID
  REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  number          Int           @unique @default(autoincrement())
  customerName    String
  phone           String
  city            String
  address         String
  bikeModel       String?
  notes           String?
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(UNPAID)
  // JazzCash / Easypaisa transaction ID, or bank reference.
  paymentRef      String?
  // Stored filename of an uploaded bank-transfer screenshot (admin-only).
  paymentProof    String?
  status          OrderStatus   @default(PENDING)
  subtotal        Int
  deliveryFee     Int
  total           Int
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  // Snapshot at time of order so later edits don't change history.
  name      String
  price     Int
  quantity  Int
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  tag         String?
  excerpt     String    @default("")
  body        String    @default("")
  coverUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Single row (id = 1) holding shop details editable from the admin panel.
model Settings {
  id                Int     @id @default(1)
  whatsapp          String  @default("")
  phone             String  @default("")
  email             String  @default("")
  address           String  @default("")
  facebookUrl       String  @default("")
  instagramUrl      String  @default("")
  metaPixelId       String  @default("")
  heroImage         String  @default("")
  jazzcashNumber    String  @default("")
  jazzcashTitle     String  @default("")
  easypaisaNumber   String  @default("")
  easypaisaTitle    String  @default("")
  bankName          String  @default("")
  bankTitle         String  @default("")
  bankIban          String  @default("")
  deliveryFee       Int     @default(250)
  freeDeliveryOver  Int     @default(0)
  codEnabled        Boolean @default(true)
  jazzcashEnabled   Boolean @default(true)
  easypaisaEnabled  Boolean @default(true)
  bankEnabled       Boolean @default(true)
}

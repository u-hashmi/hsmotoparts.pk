# --- Database (docker-compose) ---
POSTGRES_USER=hsmoto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hsmotoparts
DATABASE_URL=postgresql://hsmoto:change-me@db:5432/hsmotoparts?schema=public

# --- Admin panel (/admin) ---
ADMIN_PASSWORD=change-me-to-a-long-password
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=

# Public address of the shop (used in links, sitemap, Facebook catalog feed)
SITE_URL=https://hsmotoparts.pk

# Where uploaded photos are stored (the Docker image sets /app/uploads)
# UPLOAD_DIR=./uploads
